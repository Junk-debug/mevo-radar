{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mevo-radar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Custom domains: Cloudflare creates the DNS records and the HTTPS certificate on deploy.
  // The zone must be active in this account first. www serves the same site as the apex.
  "routes": [
    { "pattern": "mevoradar.pl", "custom_domain": true },
    { "pattern": "www.mevoradar.pl", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Bikes at stations, with frame numbers: one object rescans them on its own alarm (worker/docked.ts).
  // The free plan supports only SQLite-backed Durable Objects.
  "durable_objects": {
    "bindings": [{ "name": "DOCKED", "class_name": "DockedBikes" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DockedBikes"] }],
  // No cron any more. An explicit empty list makes the deploy delete the old */5 trigger;
  // leaving the key out would keep it firing at a Worker without a scheduled handler.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
