{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mevo-radar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create MEVO_KV — then paste the id here.
    { "binding": "MEVO_KV", "id": "2f525e40e5bf424da844ef4a2b25c101" }
  ],
  "triggers": {
    // Refresh frame numbers of bikes at stations. Free KV allows 1000 writes/day, so not every minute.
    "crons": ["*/2 * * * *"]
  },
  "observability": { "enabled": true }
}
